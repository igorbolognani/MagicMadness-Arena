{
  "name": "magicmadness-arena",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev": "vite apps/web",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && pnpm --filter @mma/web build && pnpm --filter @mma/site-worker build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm --filter @mma/game-core test -- --watch",
    "validate:content": "pnpm --filter @mma/content test",
    "assets:generate": "node tools/asset-pipeline/generate-heroes.mjs",
    "assets:validate": "node tools/asset-pipeline/validate-heroes.mjs",
    "e2e": "pnpm --filter @mma/web e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "typescript": "^5.8.3",
    "vite": "^6.2.2",
    "vitest": "^3.2.4"
  },
  "displayName": "MagicMadness Arena"
}
